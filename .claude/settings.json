{
  "permissions": {
    "allow": [
      "Read(**/*.md)",
      "Read(**/*.py)",
      "Read(**/*.json)",
      "Read(**/*.toml)",
      "Write(agents/**)",
      "Write(antigravity/**)",
      "Write(vscode/**)",
      "Write(claude/**)",
      "Write(anti-code hub/**)",
      "Write(FM-NOTES/**)",
      "Write(validators/**)",
      "Write(.agents/**)",
      "Write(.state/**)",
      "Write(main.md)",
      "Write(AGENTS.md)",
      "Write(CLAUDE.md)",
      "Write(.gitignore)",
      "Write(.geminiignore)",
      "Write(.aiexclude)",
      "Write(.vscode/settings.json)",
      "Write(.claude/settings.json)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch"
    ],
    "deny": [
      "Write(C:/Windows/**)",
      "Write(C:/Program Files/**)",
      "Write(../**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.secret)",
      "Read(credentials/**)",
      "Read(config/private/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)"
    ]
  }
}
